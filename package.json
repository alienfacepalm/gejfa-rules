{
  "name": "gejfa-rules",
  "private": true,
  "version": "1.0.0",
  "description": "Skyline Spartans sideline lookup PWA for the 2026 GEJFA rulebook",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "css": "tailwindcss -i src/tailwind.css -o docs/tailwind.css --minify",
    "test": "node tests/verify-rules.cjs",
    "screenshots": "node scripts/readme-screenshots.mjs",
    "build": "pnpm css && pnpm typecheck && pnpm test && pnpm screenshots",
    "e2e": "node scripts/e2e-frames.mjs",
    "e2e:deck": "node scripts/e2e-deck.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.9.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "minisearch": "^7.1.1"
  }
}
